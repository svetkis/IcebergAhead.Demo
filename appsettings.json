{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Exceptions"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.EntityFrameworkCore": "Error",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.AspNetCore.Mvc.Infrastructure": "Error",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
                "System.Net.Http.HttpClient.ExternalAPIHealthCheck": "Warning",
                "System.Net.Http.HttpClient.health-checks": "Warning",
                "Microsoft.Extensions.Diagnostics.HealthChecks.DefaultHealthCheckService": "Fatal",
                "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithExceptionDetails" ],
        "Properties": { "ShipName": "NLMK Steelwave" },
        "WriteTo": [
            {
                "Args": {
                    "path": "logs/logs.json",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter",
                    "rollingInterval": "Day",
                    "restrictedToMinimumLevel": "Information"
                },
                "Name": "File"
            }
        ]
    },
    "SensitiveLogging": {
        "SensitiveFields": [ "email", "phone", "password" ]
    },
    "FeatureManagement": {
        "NewUIByBrowser": {
            "EnabledFor": [
                {
                    "Name": "Browser",
                    "Parameters": {
                        "AllowedBrowsers": [ "Edge" ]
                    }
                }
            ]
        },
        "AllowedHosts": "*"
    },
    "IcebergAheadSettings": {
        "ShipName": "NLMK Steelwave",
        "ResilienceLevel": 4
    },
    "HttpClients": {
        "ExternalAPI": {
            "BaseAddress": "https://api.github.com/",
            "TimeoutSeconds": 3,
            "UserAgent": "BestPracticesDemo"
        }
    },
    "DynamicSettings": {
        "FeatureEnabled": true,
        "MaxItems": 43
    }
}